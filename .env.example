# ==============================================================================
# College Feedback Management System (CFMS) — Environment Configuration Template
# Copy this file to .env and configure appropriate values for your environment.
# ==============================================================================

# Server Configuration
PORT=8081
SPRING_PROFILES_ACTIVE=local
FRONTEND_URL=http://localhost:8080

# PostgreSQL Database Configuration (Used when SPRING_PROFILES_ACTIVE=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=college_feedback_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_URL=jdbc:postgresql://localhost:5432/college_feedback_db
DDL_AUTO=update

# JWT Authentication Secrets
# Generate a secure 256-bit (32-byte) hex or base64 key for production
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Security Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500

# AI Analytics / NLP Integration (Optional external LLM API key)
# If left unset or empty, the built-in deterministic rule-based NLP engine operates automatically.
AI_API_KEY=
AI_SERVICE_URL=
